# =====================================================================
# Smart Closet AI — variáveis de configuração
# Copie para ".env" (NUNCA faça commit do .env — já está no .gitignore).
#
# IMPORTANTE: o GitHub Pages hospeda só arquivos estáticos e não lê .env.
# Por isso há DOIS grupos de variáveis, que vão para lugares diferentes:
# =====================================================================

# ---------------------------------------------------------------------
# GRUPO 1 — FRONTEND (públicas, podem ficar no código)
# Onde usar: js/config.js  OU  GitHub > Settings > Secrets and variables
# > Actions > aba "Variables" (o workflow gera o js/config.js sozinho).
# Onde achar: Supabase > Project Settings > API
# ---------------------------------------------------------------------
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable

# ---------------------------------------------------------------------
# GRUPO 2 — EDGE FUNCTIONS (SECRETAS, só no servidor do Supabase)
# Onde usar: Supabase > Edge Functions > Secrets
#   ou pelo terminal:  npx supabase secrets set --env-file .env
# (As variáveis SUPABASE_URL / SUPABASE_ANON_KEY já são injetadas
#  automaticamente nas funções; não precisa cadastrá-las lá.)
# ---------------------------------------------------------------------

# Provedor de IA: "gemini" (padrão) ou "openai"
AI_PROVIDER=gemini

# Google Gemini — chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenAI — só preencha se AI_PROVIDER=openai (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------
# NUNCA coloque no frontend: service_role key, GEMINI_API_KEY, OPENAI_API_KEY.
# ---------------------------------------------------------------------

# VESTIR NA PESSOA (Edge Functions > Secrets)
TRYON_MODEL=gemini-2.5-flash-image
TRYON_DAILY_LIMIT=10
